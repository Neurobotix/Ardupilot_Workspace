<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Wind Sensor Probe
    =================
    Minimal standalone model for wind bench validation.
    No ArduPilot plugin — no lock_step — Gazebo runs freely.
    No LiftDrag — no aerodynamic forces.

    A single small box with enable_wind=true and one air_speed sensor.
    Dynamic (not static) — AirSpeed system skips static links.
  -->
  <model name="wind_sensor_probe">

    <link name="probe_link">
      <enable_wind>true</enable_wind>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-4</iyy><iyz>0</iyz>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box><size>0.05 0.05 0.05</size></box>
        </geometry>
        <material>
          <ambient>1 0.5 0 1</ambient>
          <diffuse>1 0.5 0 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box><size>0.05 0.05 0.05</size></box>
        </geometry>
      </collision>

      <sensor name="air_speed_sensor" type="air_speed">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/airspeed</topic>
        <air_speed>
          <pressure>
            <noise type="none"/>
          </pressure>
        </air_speed>
      </sensor>

    </link>

  </model>
</sdf>
