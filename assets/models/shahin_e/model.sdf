    </plugin>
    <!-- left inner wing panel (root + flap), 0.8 m -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.116</a0><cla>5.23</cla><cda>0.6</cda><cma>0</cma>
      <alpha_stall>0.25</alpha_stall><cla_stall>-3.85</cla_stall><cda_stall>-0.9233984055</cda_stall><cma_stall>0</cma_stall>
      <cp>0 0.400 0.08</cp><area>0.2016</area><air_density>1.2041</air_density>
