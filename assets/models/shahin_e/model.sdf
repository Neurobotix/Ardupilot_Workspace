<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Shahin-E (electric, twin tractor motors) for the GPS-denied navigation study.
    Generated by scripts/dev/gen_shahin_e_model.py (do not hand-edit). Every number is listed with its source in
    governance/runbooks/features/gps_denied_navigation/shahin_e_model_sources.md
    Origin = CG. x forward, y left, z up.
    Calibration knobs (the only values tuned at Gate 3):
      KNOB 1: <a0> of the four wing panels   (now 0.116)
      KNOB 2: <multiplier> of both motors     (now 1310)
  -->
  <model name="shahin_e">
    <link name="base_link">
      <enable_wind>true</enable_wind>
      <inertial><pose>0 0 0 0 0 0</pose><mass>10.879</mass>
        <inertia><ixx>1.4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.2</iyy><iyz>0</iyz><izz>2.5</izz></inertia>
      </inertial>
      <visual name="fuselage_visual"><pose>-0.25 0 0 0 0 0</pose><geometry><box><size>1.80 0.14 0.14</size></box></geometry><material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material></visual>
      <visual name="wing_visual"><pose>-0.0630 0 0.08 0 0 0</pose><geometry><box><size>0.252 2.5 0.03</size></box></geometry><material><ambient>0.55 0.57 0.6 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material></visual>
      <visual name="htail_visual"><pose>-1.0375 0 0 0 0 0</pose><geometry><box><size>0.15 0.6 0.01</size></box></geometry><material><ambient>0.55 0.57 0.6 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material></visual>
      <visual name="fin_visual"><pose>-1.1000 0 0.235 0 0 0</pose><geometry><box><size>0.2 0.01 0.33</size></box></geometry><material><ambient>0.3 0.33 0.38 1</ambient><diffuse>0.3 0.33 0.38 1</diffuse></material></visual>
      <collision name="fuselage_collision"><pose>-0.25 0 0 0 0 0</pose><geometry><box><size>1.80 0.14 0.14</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
      <collision name="nose_gear_collision"><pose>0.55 0 -0.22 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
      <collision name="left_main_gear_collision"><pose>-0.08 0.25 -0.22 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
      <collision name="right_main_gear_collision"><pose>-0.08 -0.25 -0.22 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose><always_on>1</always_on><update_rate>1000.0</update_rate>
      </sensor>
      <sensor name="navsat_sensor" type="navsat"><always_on>1</always_on><update_rate>1</update_rate></sensor>
      <sensor name="rangefinder" type="gpu_lidar">
        <pose>0.0 0.1 -0.01 0 1.5707963 0</pose>
        <always_on>1</always_on><update_rate>20</update_rate><topic>/shahin_e/rangefinder</topic>
        <ray>
          <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.1</min><max>12.0</max><resolution>0.01</resolution></range>
        </ray>
      </sensor>
    </link>

    <link name="pitot_link">
      <enable_wind>true</enable_wind>
      <pose>0.70 0 0 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz></inertia></inertial>
      <sensor name="air_speed_sensor" type="air_speed">
        <always_on>1</always_on><update_rate>50</update_rate><topic>/airspeed</topic>
        <air_speed><pressure><noise type="gaussian"><mean>0</mean><stddev>0.0</stddev></noise></pressure></air_speed>
      </sensor>
    </link>
    <joint name="pitot_joint" type="fixed"><parent>base_link</parent><child>pitot_link</child></joint>

    <link name="left_aileron_link">
      <pose>-0.1890 1.0250 0.08 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
      <visual name="left_aileron_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.06 0.45 0.01</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
    </link>
    <joint name="left_aileron_joint" type="revolute">
      <parent>base_link</parent><child>left_aileron_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.7</lower><upper>0.7</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="left_flap_link">
      <pose>-0.1890 0.5350 0.08 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
      <visual name="left_flap_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.06 0.53 0.01</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
    </link>
    <joint name="left_flap_joint" type="revolute">
      <parent>base_link</parent><child>left_flap_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.7</lower><upper>0.7</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="left_elevator_link">
      <pose>-1.100 0.165 0 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
      <visual name="left_elevator_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.05 0.25 0.01</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
    </link>
    <joint name="left_elevator_joint" type="revolute">
      <parent>base_link</parent><child>left_elevator_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.7</lower><upper>0.7</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="right_aileron_link">
      <pose>-0.1890 -1.0250 0.08 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
      <visual name="right_aileron_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.06 0.45 0.01</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
    </link>
    <joint name="right_aileron_joint" type="revolute">
      <parent>base_link</parent><child>right_aileron_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.7</lower><upper>0.7</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="right_flap_link">
      <pose>-0.1890 -0.5350 0.08 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
      <visual name="right_flap_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.06 0.53 0.01</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
    </link>
    <joint name="right_flap_joint" type="revolute">
      <parent>base_link</parent><child>right_flap_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.7</lower><upper>0.7</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="right_elevator_link">
      <pose>-1.100 -0.165 0 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
      <visual name="right_elevator_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.05 0.25 0.01</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
    </link>
    <joint name="right_elevator_joint" type="revolute">
      <parent>base_link</parent><child>right_elevator_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.7</lower><upper>0.7</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="rudder_link">
      <pose>-1.200 0 0.235 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
      <visual name="rudder_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.07 0.01 0.25</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
    </link>
    <joint name="rudder_joint" type="revolute">
      <parent>base_link</parent><child>rudder_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.7</lower><upper>0.7</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="left_motor_link">
      <pose degrees="true">0.19 0.3 0.06 0 90 0</pose>
      <inertial><mass>0.025</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
      <visual name="prop_visual"><geometry><cylinder><radius>0.18</radius><length>0.005</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 0.6</ambient><diffuse>0.1 0.1 0.1 0.6</diffuse></material></visual>
    </link>
    <joint name="left_motor_joint" type="revolute">
      <pose degrees="true">0 0 0 0 180 0</pose>
      <parent>base_link</parent><child>left_motor_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.0e+16</lower><upper>1.0e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis>
    </joint>
    <!-- left propeller blade A (copied from Mini Talon) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><cla>4.25</cla><cda>0.1</cda><cma>0</cma>
      <alpha_stall>1.4</alpha_stall><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0</cma_stall>
      <cp>0.084 0 0</cp><area>0.02</area><air_density>1.2041</air_density>
      <forward>0 -1 0</forward><upward>0 0 1</upward><link_name>left_motor_link</link_name>
    </plugin>
    <!-- left propeller blade B (copied from Mini Talon) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><cla>4.25</cla><cda>0.1</cda><cma>0</cma>
      <alpha_stall>1.4</alpha_stall><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0</cma_stall>
      <cp>-0.084 0 0</cp><area>0.02</area><air_density>1.2041</air_density>
      <forward>0 1 0</forward><upward>0 0 1</upward><link_name>left_motor_link</link_name>
    </plugin>
    <link name="right_motor_link">
      <pose degrees="true">0.19 -0.3 0.06 0 90 0</pose>
      <inertial><mass>0.025</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
      <visual name="prop_visual"><geometry><cylinder><radius>0.18</radius><length>0.005</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 0.6</ambient><diffuse>0.1 0.1 0.1 0.6</diffuse></material></visual>
    </link>
    <joint name="right_motor_joint" type="revolute">
      <pose degrees="true">0 0 0 0 180 0</pose>
      <parent>base_link</parent><child>right_motor_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.0e+16</lower><upper>1.0e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis>
    </joint>
    <!-- right propeller blade A (copied from Mini Talon) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><cla>4.25</cla><cda>0.1</cda><cma>0</cma>
      <alpha_stall>1.4</alpha_stall><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0</cma_stall>
