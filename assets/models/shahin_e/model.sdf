    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.06</a0><cla>4.19</cla><cda>0.1</cda><cma>0</cma>
      <alpha_stall>0.3</alpha_stall><cla_stall>-3.85</cla_stall><cda_stall>-0.9233984055</cda_stall><cma_stall>0</cma_stall>
      <cp>-1.0 -0.150 0</cp><area>0.045</area><air_density>1.2041</air_density>
      <forward>1 0 0</forward><upward>0 0 1</upward><link_name>base_link</link_name>
      <control_joint_name>right_elevator_joint</control_joint_name><control_joint_rad_to_cl>-1.8</control_joint_rad_to_cl>
    </plugin>
    <!-- vertical fin + rudder -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0><cla>3.0</cla><cda>0.1</cda><cma>0</cma>
      <alpha_stall>0.3</alpha_stall><cla_stall>-3.85</cla_stall><cda_stall>-0.9233984055</cda_stall><cma_stall>0</cma_stall>
      <cp>-1.05 0 0.235</cp><area>0.066</area><air_density>1.2041</air_density>
      <forward>1 0 0</forward><upward>0 1 0</upward><link_name>base_link</link_name>
      <control_joint_name>rudder_joint</control_joint_name><control_joint_rad_to_cl>-1.5</control_joint_rad_to_cl>
    </plugin>
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr><fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount><lock_step>1</lock_step><have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 1.57079632</gazeboXYZToNED>
      <imuName>base_link::imu_sensor</imuName>
      <airspeed_topic>/airspeed</airspeed_topic>
      <sensor><type>rangefinder</type><index>1</index><topic>/shahin_e/rangefinder</topic></sensor>
      <!-- SERVO1 Aileron 1100-1900 trim 1554 REVERSED 1 (assumed left) -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <multiplier>1.0471976</multiplier><offset>-0.5675</offset>
        <servo_min>1100</servo_min><servo_max>1900</servo_max>
        <type>COMMAND</type><cmd_topic>/shahin_e/left_aileron_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO6 Aileron 900-2150 trim 1426 REVERSED 0 (assumed right) -->
      <control channel="5">
        <jointName>right_aileron_joint</jointName>
        <multiplier>1.0471976</multiplier><offset>-0.4208</offset>
        <servo_min>900</servo_min><servo_max>2150</servo_max>
        <type>COMMAND</type><cmd_topic>/shahin_e/right_aileron_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO2 Elevator 800-2200 trim 1433 -->
      <control channel="1">
        <jointName>left_elevator_joint</jointName>
        <multiplier>1.0471976</multiplier><offset>-0.4521</offset>
        <servo_min>800</servo_min><servo_max>2200</servo_max>
        <type>COMMAND</type><cmd_topic>/shahin_e/left_elevator_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO7 Elevator 800-2200 trim 1433 -->
      <control channel="6">
        <jointName>right_elevator_joint</jointName>
        <multiplier>1.0471976</multiplier><offset>-0.4521</offset>
        <servo_min>800</servo_min><servo_max>2200</servo_max>
        <type>COMMAND</type><cmd_topic>/shahin_e/right_elevator_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO3 Flap 1300-1800 REVERSED 1: 1800 = retracted, 1300 = full (0.7 rad down) -->
      <control channel="2">
        <jointName>left_flap_joint</jointName>
        <multiplier>0.7</multiplier><offset>-1.0</offset>
        <servo_min>1300</servo_min><servo_max>1800</servo_max>
        <type>COMMAND</type><cmd_topic>/shahin_e/left_flap_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO8 Flap 1300-1800 REVERSED 1 -->
      <control channel="7">
        <jointName>right_flap_joint</jointName>
        <multiplier>0.7</multiplier><offset>-1.0</offset>
        <servo_min>1300</servo_min><servo_max>1800</servo_max>
        <type>COMMAND</type><cmd_topic>/shahin_e/right_flap_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO5 Rudder 950-2200 trim 1500; sign flipped at Gate 1 (2026-10-13): yaw right gave +joint = nose left -->
      <control channel="4">
        <jointName>rudder_joint</jointName>
        <multiplier>-1.0471976</multiplier><offset>-0.44</offset>
        <servo_min>950</servo_min><servo_max>2200</servo_max>
        <type>COMMAND</type><cmd_topic>/shahin_e/rudder_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO11 Throttle Left 1100-2000 -->
      <control channel="10">
        <jointName>left_motor_joint</jointName>
        <multiplier>1310</multiplier><offset>0</offset>
        <servo_min>1100</servo_min><servo_max>2000</servo_max>
        <type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>1</i_max><i_min>-1</i_min><cmd_max>5.0</cmd_max><cmd_min>-5.0</cmd_min>
      </control>
      <!-- SERVO12 Throttle Right 1100-2000 -->
      <control channel="11">
        <jointName>right_motor_joint</jointName>
        <multiplier>1310</multiplier><offset>0</offset>
        <servo_min>1100</servo_min><servo_max>2000</servo_max>
        <type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>1</i_max><i_min>-1</i_min><cmd_max>5.0</cmd_max><cmd_min>-5.0</cmd_min>
      </control>
    </plugin>
  </model>
</sdf>
