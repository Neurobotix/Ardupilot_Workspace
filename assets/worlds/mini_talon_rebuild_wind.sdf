<?xml version="1.0"?>
<!--
  mini_talon_rebuild_wind.sdf
  ============================
  PHASE 0 STATUS: PLACEHOLDER — functionally identical to still_air.
  Wind elements are present but commented out.
  Do NOT uncomment anything until Phase 1 (still-air baseline) PASSES.

  Phase activation plan:
    Phase 1 PASS  → uncomment <wind> + WindEffects plugin
    Phase 2 PASS  → uncomment gz-sim-air-speed-system + add sensor to model
    Phase 3+      → turbulence / gusts (not yet defined)

  One-source rule: ONLY Gazebo wind. SITL SIM_WIND_SPD stays 0 forever in this rebuild.
-->
<sdf version="1.9">
  <world name="mini_talon_rebuild_wind">

    <!-- ============================================================
         WORLD PLUGINS
         ============================================================ -->
    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <!-- PHASE 2: Uncomment when airspeed sensor is added to the model.
    <plugin filename="gz-sim-air-speed-system"
      name="gz::sim::systems::AirSpeed">
    </plugin>
    -->

    <!-- PHASE 1: Uncomment WindEffects when still-air baseline passes.
         Architecture notes:
           - <wind> sets the global wind vector (ENU frame)
           - WindEffects maintains WorldLinearVelocity on the wind entity each tick
             so that LiftDrag plugins and air_speed sensor receive consistent data
           - force_approximation_scaling_factor=0.001 keeps direct push force
             negligible (1.8kg * 0.001 * 5m/s = 0.009N = 0.05% of gravity)
             The real aerodynamic effect comes from LiftDrag reading wind velocity
           - time_for_rise ramps the wind up gradually — avoids impulse on spawn
    <wind>
      <linear_velocity>-5 0 0</linear_velocity>
    </wind>
    <plugin filename="gz-sim-wind-effects-system"
      name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>0.001</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin><amplitude_percent>0</amplitude_percent></sin>
          <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
        </magnitude>
        <direction>
          <time_for_rise>10</time_for_rise>
          <sin><amplitude>0</amplitude></sin>
          <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
      </vertical>
    </plugin>
    -->

    <!-- ============================================================
         PHYSICS
         ============================================================ -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ============================================================
         SCENE
         ============================================================ -->
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.9 1.0</background>
      <sky></sky>
    </scene>

    <!-- ============================================================
         SPHERICAL COORDINATES
         ============================================================ -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- ============================================================
         SUN
         ============================================================ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ============================================================
         GROUND PLANE — identical spec to still_air world
         ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <min_depth>0.001</min_depth>
                <max_vel>1.0</max_vel>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.5 0.3 1</ambient>
            <diffuse>0.4 0.5 0.3 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ENU AXIS MARKER
         ============================================================ -->
    <model name="axes">
      <static>true</static>
      <link name="link">
        <visual name="x_axis">
          <cast_shadows>false</cast_shadows>
          <pose>5 0 0.05 0 0 0</pose>
          <geometry><box><size>10 0.04 0.04</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive>
          </material>
        </visual>
        <visual name="y_axis">
          <cast_shadows>false</cast_shadows>
          <pose>0 5 0.05 0 0 0</pose>
          <geometry><box><size>0.04 10 0.04</size></box></geometry>
          <material>
            <ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive>
          </material>
        </visual>
        <visual name="z_axis">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 5.05 0 0 0</pose>
          <geometry><box><size>0.04 0.04 10</size></box></geometry>
          <material>
            <ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse><emissive>0 0 1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         AIRCRAFT
         PHASE 1: model has no airspeed sensor, no enable_wind.
         PHASE 2: swap to mini_talon_rebuild_v2 that adds airspeed sensor link.
         ============================================================ -->
    <include>
      <pose degrees="true">0 0 0.195 0 0 0</pose>
      <uri>model://mini_talon_rebuild</uri>
      <!-- enable_wind: NOT set here. Will be added in Phase 2 when WindEffects is active. -->
    </include>

  </world>
</sdf>
