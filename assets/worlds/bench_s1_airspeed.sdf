<?xml version="1.0" ?>
<!--
  Bench S1 — Airspeed Sensor + ArduPilot Integration
  ====================================================
  Builds on the proven wind bench (mini_talon_wind_bench.sdf).
  Same wind pipeline, same 5 m/s input — but now with the real
  mini_talon_with_airspeed model and ArduPilot plugin connected.

  Goal: prove ArduPilot receives the /airspeed diff_pressure and
        reports a non-zero airspeed reading in the GCS.

  Verification (two sides must agree):
    Gazebo side:   gz topic -e -t /airspeed        → diff_pressure ≈ -15.3 Pa
    ArduPilot side: MAVProxy → "airspeed X.XX m/s" → expect ≈ 5 m/s

  Run order:
    1. Launch Gazebo:
         gz sim src/SIM_ARD_GAW/worlds/bench_s1_airspeed.sdf -r 2>/dev/null
    2. Launch SITL (separate terminal):
         sim_vehicle.py -v ArduPlane -f gazebo-zephyr model JSON \
           add-param-file=src/SIM_ARD_GAW/config/plane_params_rebuild.parm \
           console map
    3. Arm is NOT required — just confirm airspeed reads ~5 m/s at rest.

  Model is NOT static — AirSpeed system skips static links (proven lesson).
  Aircraft sits on the ground: no throttle command = no motor = no flight.
  SIM_WIND_SPD=0 in params file — Gazebo wind is the one and only source.
-->
<sdf version="1.9">
  <world name="bench_s1_airspeed">

    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <!-- Proven wind pipeline — copied verbatim from mini_talon_wind_bench.sdf.
         time_for_rise MUST be > 0 (0 causes WindEffects.cc:353 error). -->
    <plugin filename="gz-sim-wind-effects-system"
      name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>0.001</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>0.1</time_for_rise>
          <sin><amplitude_percent>0</amplitude_percent></sin>
          <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
        </magnitude>
        <direction>
          <time_for_rise>0.1</time_for_rise>
          <sin><amplitude>0</amplitude></sin>
          <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
      </vertical>
    </plugin>

    <!-- Required: enables the air_speed sensor type -->
    <plugin filename="gz-sim-air-speed-system"
      name="gz::sim::systems::AirSpeed">
    </plugin>

    <!-- THE INPUT — same as wind bench W1 case, proven to produce 15.3 Pa -->
    <wind>
      <linear_velocity>5 0 0</linear_velocity>
    </wind>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Inline ground plane with friction — keeps aircraft on the ground. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>5000 5000</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>5000 5000</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- wind_sitl_probe: ArduPilot plugin + air_speed sensor, NO LiftDrag.
         No LiftDrag = wind cannot push it = stable diff_pressure reading.
         NOT static: AirSpeed system skips static links (proven lesson). -->
    <include>
      <uri>model://wind_sitl_probe</uri>
      <pose>0 0 0.5 0 0 0</pose>
      <enable_wind>true</enable_wind>
    </include>

  </world>
</sdf>
