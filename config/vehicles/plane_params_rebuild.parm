# plane_params_rebuild.parm
# ==========================
# ArduPlane parameters for the CLEAN-ROOM WIND REBUILD.
# Standalone rebuild lane. Do not stack with plane_base.parm or sensor overlays.
#
# Rebuild-specific overrides are marked with [REBUILD].
# Do NOT add wind, turbulence, or autocal here until explicitly unlocked per phase.
#
# Phase unlock plan:
#   Phase 0 (now)   : SIM_WIND_SPD=0, SIM_WIND_TURB=0, ARSPD_AUTOCAL=0  [enforced]
#   Phase 1         : Still-air flight baseline — no param changes needed
#   Phase 2         : Gazebo wind active — still keep SIM_WIND_SPD=0
#   Phase 3         : Airspeed sensor added — set ARSPD_TYPE=100, ARSPD_USE=1 if not already

# Enable JSON backend for Gazebo
SIM_JSON_MASTER 1

# Throttle failsafe - disabled for simulation
THR_FAILSAFE 0

# ============ V-TAIL SERVO CONFIGURATION (MINI TALON) ============
SERVO1_FUNCTION  4        # Aileron
SERVO1_MIN       1100
SERVO1_MAX       1900
SERVO1_TRIM      1500
SERVO1_REVERSED  0

SERVO2_FUNCTION  79       # Left V-Tail (Ruddervator)
SERVO2_MIN       1100
SERVO2_MAX       1900
SERVO2_TRIM      1500
SERVO2_REVERSED  0

SERVO3_FUNCTION  70       # Throttle
SERVO3_MIN       1100
SERVO3_MAX       1900
SERVO3_TRIM      1100
SERVO3_REVERSED  0

SERVO4_FUNCTION  80       # Right V-Tail (Ruddervator)
SERVO4_MIN       1100
SERVO4_MAX       1900
SERVO4_TRIM      1500
SERVO4_REVERSED  0

# ============ AIRSPEED SETTINGS ============
ARSPD_TYPE       100       # JSON airspeed — ArduPilotPlugin feeds via FDM JSON
ARSPD_USE        1
ARSPD_AUTOCAL    0         # [REBUILD] EXPLICITLY DISABLED — do not enable until Phase 3
ARSPD_SKIP_CAL   1         # [REBUILD] Keep the saved offset; do not zero-calibrate in active Gazebo wind
ARSPD_OFFSET     0         # [REBUILD] JSON airspeed already represents the desired pitot signal
AIRSPEED_CRUISE  14        # 14 m/s cruise speed
AIRSPEED_MIN     10
AIRSPEED_MAX     22
STALL_PREVENTION 1

# ============ NAVIGATION TUNING ============
NAVL1_PERIOD     17
NAVL1_DAMPING    0.75
WP_RADIUS        20
WP_LOITER_RAD    50

# ============ FLIGHT LIMITS ============
LIM_ROLL_CD      4500
LIM_PITCH_MIN    -10
LIM_PITCH_MAX    20

# ============ THROTTLE SETTINGS ============
THR_MIN          0
THR_MAX          100
TRIM_THROTTLE    55

# ============ RTL SETTINGS ============
RTL_AUTOLAND     2
RTL_ALTITUDE     50

# ============ LANDING PARAMETERS ============
LAND_FLARE_ALT   1
LAND_FLARE_SEC   0.5
LAND_PITCH_DEG   3
TECS_LAND_SINK   0.3
TECS_APPR_SMAX   0.5
TECS_SINK_MAX    1.5
TECS_LAND_ARSPD  12
TECS_LAND_SPDWGT 2.0
TECS_FLARE_HGT   0.5
LAND_FLARE_AIM   20
TECS_LAND_THR    50
LAND_THR_SLEW    70
TECS_LAND_TCONST 2
LAND_ABORT_THR   70
LAND_DISARMDELAY 30
LAND_TYPE        0
GROUND_STEER_ALT 0
GROUND_STEER_DPS 0
LAND_OPTIONS     1
WHEEL_STEER_GAIN 0
TECS_THR_DAMP    0.5
TECS_PITCH_MIN   -10

# ============ RANGEFINDER ============
# [REBUILD] LiDAR disabled — no rangefinder in this rebuild
RNGFND_LANDING   0
RNGFND1_TYPE     0         # [REBUILD] Disabled (was 10=MAVLink in plane_params.parm)

# ============ EKF / AHRS SETTINGS ============
AHRS_EKF_TYPE    3
EK3_ENABLE       1
EK2_ENABLE       0

# ============ GROUND STEERING / TAKEOFF ============
GROUND_STEER_ALT 5
TKOFF_THR_SLEW   100
TKOFF_ROTATE_SPD 12

# ============ WIND SIMULATION (SITL) ============
# [REBUILD] ALL SITL WIND DISABLED — Gazebo is the sole wind source for this rebuild.
# These values must remain 0 through ALL phases of this rebuild.
SIM_WIND_SPD     0         # [REBUILD] EXPLICITLY DISABLED
SIM_WIND_DIR     180       # (inactive — SPD=0)
SIM_WIND_TURB    0         # [REBUILD] EXPLICITLY DISABLED
AHRS_WIND_MAX    15        # EKF accepts up to 15 m/s wind (enough for Gazebo wind phases)

# ============ AUTO MODE SETTINGS ============
AUTO_FBW_STEER   0
SKIP_GYRO_CAL    1
