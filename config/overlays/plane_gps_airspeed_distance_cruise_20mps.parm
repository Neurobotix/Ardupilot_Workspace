# ArduPlane Parameters - GPS Failure Distance-Denial 20 m/s Envelope
#
# Apply after config/vehicles/plane_base.parm and config/overlays/plane_gps.parm.
# The mission intentionally has no DO_CHANGE_SPEED command; AIRSPEED_CRUISE is
# the single cruise-speed source.

ARSPD_TYPE 100
ARSPD_USE 1
ARSPD_AUTOCAL 0
ARSPD_SKIP_CAL 1
ARSPD_OFFSET 0

AIRSPEED_CRUISE 20
AIRSPEED_MIN 12
AIRSPEED_MAX 28
STALL_PREVENTION 1

THR_MAX 100
TRIM_THROTTLE 60
TECS_SPDWEIGHT 1.7
TECS_CLMB_MAX 8
TECS_SINK_MAX 3

SIM_WIND_SPD 0
SIM_WIND_DIR 180
SIM_WIND_TURB 0
AHRS_WIND_MAX 15
